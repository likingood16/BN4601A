#!/bin/bash
#PBS -N pipeline_check
#PBS -j oe
# The joined-up pipeline: same scores as saved? results used in chat and SBAR? Base vs Adapted vs detector on 463 X-rays?
#   qsub -q auto_free -l select=1:ncpus=8:mem=64gb:ngpus=1 -l walltime=12:00:00 -o reasoning/outputs/logs reasoning/hpc/jobs/pipeline_check.pbs
cd "$PBS_O_WORKDIR"
source reasoning/hpc/hpc.conf
export HF_HOME HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 BN4601A_BASE_MODEL=unsloth/medgemma-1.5-4b-it BN4601A_IMAGE_BASE=unsloth/medgemma-4b-it YOLO_OFFLINE=true
cd reasoning/src
for part in scores results images; do
  "$VENV/bin/python" -u pipeline_check.py --part $part 2>&1 | tee ../outputs/logs/pipeline_check_${part}_live.log
done

#!/bin/bash
#PBS -N bn4601a_embed_eval
#PBS -j oe
# Embeddings for all cards (full precision, 16 cards at a time) -> score heads -> base vs LoRA evaluation.
# Submitted by submit.sh:  bash reasoning/hpc/submit.sh embed
#   optional ADAPTERS, comma-separated:  ADAPTERS=mixed/stage1,emergency/stage1 bash reasoning/hpc/submit.sh embed
cd "$PBS_O_WORKDIR"
source reasoning/hpc/hpc.conf
export HF_HOME HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 BN4601A_BASE_MODEL=unsloth/medgemma-1.5-4b-it
PY="$VENV/bin/python"
cd reasoning/src
$PY embed.py --table cards_pool1 --name base_full --mode full --batch 16
$PY embed.py --table cards_multicare --name base_full --mode full --batch 8
$PY heads.py --emb base_full --train-on ktas
$PY heads.py --emb base_full --train-on ktas+nhamcs
$PY ../training/evaluate.py --mode full --per-source 100 --medqa ${ADAPTERS//,/ }

#!/bin/bash
#PBS -N ai_reasoning
#PBS -j oe
# Tests for the all-AI reasoning version (branch ai-reasoning, 8 Nov 2026), on one A40:
#   1. MedGemma reads the numbers: 190 KTAS test notes, clean and messy (charting_check.py --ai); rules scored 100%
#   2. AI pathway flags on reworded complaints vs the old word rules (pathway_reworded_check.py)
#   3. the full app with the real AI: the 10-note real-AI check (real_ai_check.py), results kept as real_ai_check_ai.md
#   qsub -q auto_free -l select=1:ncpus=8:mem=64gb:ngpus=1 -l walltime=05:00:00 -o reasoning/outputs/logs reasoning/hpc/jobs/ai_reasoning_check.pbs
set -o pipefail
cd "$PBS_O_WORKDIR"
source reasoning/hpc/hpc.conf
export HOME=$ROOT/home HF_HOME HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 YOLO_OFFLINE=true TQDM_DISABLE=1 \
       BN4601A_BASE_MODEL=unsloth/medgemma-1.5-4b-it BN4601A_IMAGE_BASE=unsloth/medgemma-1.5-4b-it
nvidia-smi --query-gpu=name,memory.total --format=csv
cd reasoning/checks
if [ -z "$SKIP_NUMBERS" ]; then                      # qsub -v SKIP_NUMBERS=1: numbers already tested
echo "== 1. numbers by AI $(date)"
"$VENV/bin/python" -u charting_check.py --ai --split test
"$VENV/bin/python" -u charting_check.py --ai --split test --messy
fi
echo "== 2. pathway flags on reworded notes $(date)"
"$VENV/bin/python" -u pathway_reworded_check.py
echo "== 3. full app, real AI $(date)"
cd ../../app
PORT=8011
"$VENV/bin/python" -u server.py --port $PORT --case-files "" &
SERVER=$!
for i in $(seq 1 120); do curl -s "http://127.0.0.1:$PORT/api/meta" >/dev/null && break; sleep 5; done
"$VENV/bin/python" -u tests/real_ai_check.py --url "http://127.0.0.1:$PORT" && cp ../reasoning/outputs/real_ai_check.md ../reasoning/outputs/real_ai_check_ai.md
kill $SERVER; wait $SERVER 2>/dev/null
echo "== done $(date)"
